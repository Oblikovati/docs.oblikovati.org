          "action": "Sketch.Rotate"
        },
        {
          "canonical": "SCALE",
          "aliases": [
            "SC"
          ],
          "summary": "Scale sketch geometry about a point.",
          "example": "SCALE (select) 0,0 2",
          "action": "Sketch.Scale"
