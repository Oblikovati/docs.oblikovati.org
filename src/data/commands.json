        {
          "canonical": "SKETCH3D",
          "aliases": [],
          "summary": "Start a new 3D sketch.",
          "example": "SKETCH3D",
          "action": "Sketch.Create3D"
        },
        {
          "canonical": "SLOT",
          "aliases": [],
          "summary": "Draw a straight slot by two centres and a width.",
          "example": "SLOT 0,0 10,0 2",
          "action": "Sketch.Slot"
        },
        {
          "canonical": "SPLINE",
          "aliases": [
            "SPL"
          ],
          "summary": "Draw an interpolated spline through points.",
          "example": "SPLINE 0,0 5,5 10,0",
          "action": "Sketch.Spline"
        },
        {
          "canonical": "STRETCH",
          "aliases": [],
          "summary": "Stretch sketch geometry by moving vertices.",
          "example": "STRETCH (select) 0,0 5,0",
          "action": "Sketch.Stretch"
        },
        {
          "canonical": "TEXT",
          "aliases": [
            "MTEXT"
          ],
          "summary": "Place sketch text.",
          "example": "TEXT 0,0",
          "action": "Sketch.Text"
        },
        {
          "canonical": "TRIM",
          "aliases": [
            "TR"
          ],
          "summary": "Trim sketch geometry to the nearest intersection.",
          "example": "TRIM (segment)",
          "action": "Sketch.Trim"
