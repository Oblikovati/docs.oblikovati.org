        {
          "canonical": "GCCONCENTRIC",
          "aliases": [],
          "summary": "Constrain two arcs/circles concentric.",
          "example": "GCCONCENTRIC (c1) (c2)",
          "action": "Sketch.Concentric"
        },
        {
          "canonical": "GCEQUAL",
          "aliases": [],
          "summary": "Constrain two entities to equal size.",
          "example": "GCEQUAL (a) (b)",
          "action": "Sketch.Equal"
        },
        {
          "canonical": "GCFIX",
          "aliases": [],
          "summary": "Fix a point or curve in place.",
          "example": "GCFIX (entity)",
          "action": "Sketch.Fix"
        },
        {
          "canonical": "GCHORIZONTAL",
          "aliases": [],
          "summary": "Constrain a line horizontal.",
          "example": "GCHORIZONTAL (line)",
          "action": "Sketch.Horizontal"
        },
        {
          "canonical": "GCPARALLEL",
          "aliases": [],
          "summary": "Constrain two lines parallel.",
          "example": "GCPARALLEL (line1) (line2)",
          "action": "Sketch.Parallel"
        },
        {
          "canonical": "GCPERPENDICULAR",
          "aliases": [],
          "summary": "Constrain two lines perpendicular.",
          "example": "GCPERPENDICULAR (line1) (line2)",
          "action": "Sketch.Perpendicular"
        },
        {
          "canonical": "GCSMOOTH",
          "aliases": [],
          "summary": "Constrain a spline smooth (curvature-continuous) to a curve.",
          "example": "GCSMOOTH (spline) (curve)",
          "action": "Sketch.Smooth"
        },
        {
          "canonical": "GCSYMMETRIC",
          "aliases": [],
          "summary": "Constrain two entities symmetric about a line.",
          "example": "GCSYMMETRIC (a) (b) (line)",
          "action": "Sketch.Symmetric"
        },
        {
          "canonical": "GCTANGENT",
          "aliases": [],
          "summary": "Constrain a curve tangent to another.",
          "example": "GCTANGENT (curve) (line)",
          "action": "Sketch.Tangent"
        },
        {
          "canonical": "GCVERTICAL",
          "aliases": [],
          "summary": "Constrain a line vertical.",
          "example": "GCVERTICAL (line)",
          "action": "Sketch.Vertical"
        },
        {
          "canonical": "INSERT",
          "aliases": [],
          "summary": "Insert a sketch block instance.",
          "example": "INSERT (block) 5,5",
          "action": "Sketch.PlaceBlock"
        },
        {
          "canonical": "LINE",
          "aliases": [],
          "summary": "Draw a line or connected polyline in the active sketch.",
          "example": "LINE 0,0 10,0 10,5",
          "action": "Sketch.Line"
        },
        {
          "canonical": "MIRROR",
          "aliases": [
            "MI"
          ],
          "summary": "Mirror sketch geometry about a centerline.",
          "example": "MIRROR (select) (line)",
          "action": "Sketch.Mirror"
        },
        {
          "canonical": "MOVE",
          "aliases": [],
          "summary": "Move sketch geometry by a vector.",
          "example": "MOVE (select) 0,0 10,0",
          "action": "Sketch.Move"
        },
        {
          "canonical": "OFFSET",
          "aliases": [],
          "summary": "Offset selected sketch geometry by a distance.",
          "example": "OFFSET 2 (select)",
          "action": "Sketch.Offset"
        },
        {
          "canonical": "POINT",
          "aliases": [
            "PO"
          ],
          "summary": "Place a sketch point.",
          "example": "POINT 5,5",
          "action": "Sketch.Point"
        },
        {
          "canonical": "POLYGON",
          "aliases": [
            "POL"
          ],
          "summary": "Draw a regular polygon by edge count and radius.",
