{
  "source": "oblikovati.org/app/cmdline Vocabulary.ManualGroups()",
  "groups": [
    {
      "title": "Sketch — draw \u0026 modify",
      "commands": [
        {
          "canonical": "ARC",
          "aliases": [],
          "summary": "Draw an arc through points or by centre.",
          "example": "ARC 0,0 5,5 10,0",
          "action": "Sketch.Arc"
        },
        {
          "canonical": "ARRAYPOLAR",
          "aliases": [],
          "summary": "Pattern sketch geometry around a centre.",
          "example": "ARRAYPOLAR (select) 0,0 6",
          "action": "Sketch.CircularPattern"
        },
        {
          "canonical": "ARRAYRECT",
          "aliases": [],
          "summary": "Pattern sketch geometry in rows and columns.",
          "example": "ARRAYRECT (select) 3 2",
          "action": "Sketch.RectangularPattern"
        },
        {
          "canonical": "AUTODIMENSION",
          "aliases": [
            "AUTODIM"
          ],
          "summary": "Auto-dimension the sketch to remove its degrees of freedom.",
          "example": "AUTODIM (select sketch)",
          "action": "Sketch.AutoDimension"
        },
        {
          "canonical": "BLOCK",
          "aliases": [],
          "summary": "Create a sketch block from selected geometry.",
          "example": "BLOCK (select)",
          "action": "Sketch.CreateBlock"
        },
        {
          "canonical": "BREAK",
          "aliases": [
            "BR"
          ],
          "summary": "Split a sketch entity at a point.",
          "example": "BREAK (entity) (point)",
          "action": "Sketch.Split"
        },
        {
          "canonical": "CENTERLINE",
          "aliases": [],
          "summary": "Draw a centerline (excluded from profiles; consumed by mirror/revolve).",
          "example": "CENTERLINE 0,0 10,0",
          "action": "Sketch.Centerline"
        },
        {
          "canonical": "CHAMFER",
          "aliases": [
            "CHA"
          ],
          "summary": "Bevel a corner between two sketch entities.",
          "example": "CHAMFER (two lines) 2",
          "action": "Sketch.Chamfer"
        },
        {
          "canonical": "CIRCLE",
          "aliases": [],
          "summary": "Draw a circle by centre and radius.",
          "example": "CIRCLE 0,0 5",
          "action": "Sketch.Circle"
        },
        {
          "canonical": "CONSTRUCTION",
          "aliases": [],
          "summary": "Toggle selected sketch geometry to construction.",
          "example": "CONSTRUCTION (select)",
          "action": "Sketch.Construction"
        },
        {
          "canonical": "COPY",
          "aliases": [
            "CO",
            "CP"
          ],
          "summary": "Copy sketch geometry by a vector.",
          "example": "COPY (select) 0,0 10,0",
          "action": "Sketch.Copy"
        },
        {
          "canonical": "DIMENSION",
          "aliases": [
            "DIM"
          ],
          "summary": "Add a parametric dimension to sketch geometry.",
          "example": "DIM (select) 25",
          "action": "Sketch.Dimension"
        },
        {
          "canonical": "ELLIPSE",
          "aliases": [
            "EL"
          ],
          "summary": "Draw an ellipse by centre and two axes.",
          "example": "ELLIPSE 0,0 10 5",
          "action": "Sketch.Ellipse"
        },
        {
          "canonical": "EXTEND",
          "aliases": [
            "EX"
          ],
          "summary": "Extend sketch geometry to a boundary.",
          "example": "EXTEND (segment)",
          "action": "Sketch.Extend"
        },
        {
          "canonical": "FILLET",
          "aliases": [],
          "summary": "Round a corner between two sketch entities.",
          "example": "FILLET (two lines) 2",
          "action": "Sketch.Fillet"
        },
        {
          "canonical": "FINISHSKETCH",
          "aliases": [
            "FINISH"
          ],
          "summary": "Finish the active sketch.",
          "example": "FINISH",
          "action": "Sketch.Finish"
        },
        {
          "canonical": "GCCOINCIDENT",
          "aliases": [],
          "summary": "Constrain two points (or a point and a curve) coincident.",
          "example": "GCCOINCIDENT (A) (B)",
          "action": "Sketch.Coincident"
